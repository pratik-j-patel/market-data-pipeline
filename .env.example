# Copy this file to .env and fill in your real values.
# .env is gitignored; this example file is safe to commit.

# --- Secrets ---
# Set with scripts/set_api_key.sh
POLYGON_API_KEY=your_key_here
# Set with scripts/set_aws_keys.sh
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_secret_here

# --- Not secret, but kept here anyway ---
# The bucket name and region live in .env rather than in code so that the
# repo carries no reference to a specific AWS account's resources.
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=your-bucket-name
